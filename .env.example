# NIJER MARKET API environment template.
# Copy to server/.env and fill in your own values. Never commit the real .env file.

# "development" allows demo fallbacks; "production" requires every variable below.
NODE_ENV=development
PORT=5000

# MongoDB connection string. Leave empty to run with in-memory demo data (development only).
MONGO_URI=

# Optional custom DNS servers (comma-separated IPs) if SRV resolution fails locally.
MONGO_DNS_SERVERS=

# JWT signing secret. Use a long random string (32+ characters; required in production).
JWT_SECRET=

# Initial admin account created on first startup. Required in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Customer app origin used for CORS. Comma-separated extra origins via CORS_ORIGINS.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5174

# Cloudinary image storage. Required for product image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Manual UPI payment details shown to customers at checkout.
UPI_ID=
# Public HTTPS image URL (or same-origin path) of the UPI QR code.
UPI_QR_CODE_URL=